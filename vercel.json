{
    "redirects": [
        {
            "source": "/",
            "destination": "/bloodconnect",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/bloodconnect/assets/:path*",
            "destination": "/assets/:path*"
        },
        {
            "source": "/bloodconnect/:path*",
            "destination": "/index.html"
        }
    ]
}